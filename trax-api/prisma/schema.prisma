// =============================================================================
// Trax — Prisma Schema
// PostgreSQL 16 | Multi-Tenant SaaS
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum AgencyPlan {
  TRIAL
  STARTER
  PRO
  AGENCY
  ENTERPRISE
}

enum UserRole {
  AGENCY_ADMIN // Administrador da agência (acesso total)
  AGENCY_VIEWER // Visualizador da agência (somente leitura)
  COMPANY_VIEWER // Visualizador de empresa(s) específica(s)
}

enum IntegrationProvider {
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  META_ADS
  TIKTOK_ADS
  LINKEDIN_ADS
  INSTAGRAM
  FACEBOOK_PAGE
  NECTAR_CRM
  RD_STATION
  CUSTOM
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_AUTH
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditActorType {
  AGENCY_USER
  SUPER_ADMIN
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  SYNC
  TEST
  INVITE
  OAUTH_CONNECT
}

enum AuditEntityType {
  AGENCY
  COMPANY
  USER
  REPORT
  INTEGRATION
  AUTH
}

// ---------------------------------------------------------------------------
// AGENCY — O tenant raiz. Cada agência é isolada.
// ---------------------------------------------------------------------------
model Agency {
  id                   String     @id @default(uuid()) @db.Uuid
  name                 String     @db.VarChar(255)
  slug                 String     @unique @db.VarChar(100) // subdomínio: slug.trax.app
  customDomain         String?    @unique @db.VarChar(255) // domínio próprio: relatorios.agencia.com
  logoUrl              String?    @db.VarChar(1024)
  faviconUrl           String?    @db.VarChar(1024)
  primaryColor         String     @default("#6366F1") @db.VarChar(7) // Hex #RRGGBB
  secondaryColor       String     @default("#818CF8") @db.VarChar(7)
  accentColor          String     @default("#F59E0B") @db.VarChar(7)
  fontFamily           String     @default("Inter") @db.VarChar(100)
  themeMode            String     @default("dark") @db.VarChar(20) // "light", "dark", "system"
  borderRadius         String     @default("medium") @db.VarChar(20) // "none", "small", "medium", "large", "full"
  portalLayout         String     @default("sidebar") @db.VarChar(20) // "sidebar", "topbar"
  loginLayout          String     @default("centered") @db.VarChar(20) // "centered", "split"
  loginBackgroundUrl   String?    @db.VarChar(1024)
  loginTitle           String?    @db.VarChar(255)
  loginSubtitle        String?    @db.VarChar(255)
  // Billing & Planos
  plan                 AgencyPlan @default(TRIAL)
  stripeCustomerId     String?    @unique @db.VarChar(255)
  stripeSubscriptionId String?    @unique @db.VarChar(255)
  maxCompanies         Int        @default(2)
  maxUsers             Int        @default(1)
  trialEndsAt          DateTime?

  // Personalização avançada
  customCss    String? @db.Text
  supportEmail String? @db.VarChar(255)
  reportFooter String? @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  companies   Company[]
  users       User[]
  reports     Report[]
  auditLogs   AgencyAuditLog[]
  scheduledPosts ScheduledPost[]

  @@map("agencies")
}

// ---------------------------------------------------------------------------
// COMPANY — Empresas da agência. Isoladas por agencyId.
// ---------------------------------------------------------------------------
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @db.Uuid
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  website   String?  @db.VarChar(512)
  logoUrl   String?  @db.VarChar(1024)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  agency         Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  integrations   Integration[]
  reports        Report[]
  userCompanies  UserCompany[]
  scheduledPosts ScheduledPost[]
  metaConfig     CompanyMetaConfig?

  @@index([agencyId])
  @@index([agencyId, isActive])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// USER — Autenticação. Vinculado a uma agência.
// ---------------------------------------------------------------------------
model User {
  id              String    @id @default(uuid()) @db.Uuid
  agencyId        String    @db.Uuid
  email           String    @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  role            UserRole  @default(COMPANY_VIEWER)
  avatarUrl       String?   @db.VarChar(1024)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  // Preferências de notificação por e-mail
  notifyReportPublished   Boolean @default(true) @map("notify_report_published")
  notifyIntegrationErrors Boolean @default(true) @map("notify_integration_errors")
  notifyNewCompany        Boolean @default(false) @map("notify_new_company")
  notifyWeeklySummary     Boolean @default(true) @map("notify_weekly_summary")
  // 2FA TOTP
  totpSecret      String?   @db.VarChar(64) @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  agency        Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  userCompanies UserCompany[] // Empresas que o usuário pode visualizar
  auditLogs     AgencyAuditLog[]

  // Email único POR AGÊNCIA (não global — mesma pessoa pode ser user em 2 agências)
  @@unique([agencyId, email])
  @@index([agencyId])
  @@index([agencyId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// USER_COMPANY — Relação N:N entre User COMPANY_VIEWER e suas empresas visíveis
// ---------------------------------------------------------------------------
model UserCompany {
  userId    String @db.Uuid
  companyId String @db.Uuid
  agencyId  String @db.Uuid // Denormalizado para queries multi-tenant eficientes

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([agencyId, userId])
  @@map("user_companies")
}

// ---------------------------------------------------------------------------
// REFRESH TOKEN — Tokens de refresh com revogação individual
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255) // SHA-256 do token
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(512)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// INTEGRATION — Conexões de plataformas de anúncios/analytics por cliente
// Credenciais armazenadas CRIPTOGRAFADAS (AES-256-GCM)
// ---------------------------------------------------------------------------
model Integration {
  id              String              @id @default(uuid()) @db.Uuid
  agencyId        String              @db.Uuid // Denormalizado para isolamento multi-tenant
  companyId       String              @db.Uuid
  provider        IntegrationProvider
  status          IntegrationStatus   @default(PENDING_AUTH)
  displayName     String?             @db.VarChar(255)
  // Armazenado como JSON criptografado: { iv, authTag, data }
  credentialsEnc  String              @db.Text
  // Metadados não-sensíveis: { adAccountId, pageId, nectarBaseUrl, campaignIds, ... }
  metadata        Json?
  externalAccount String?             @db.VarChar(255) // ID da conta na plataforma
  lastSyncAt      DateTime?
  lastErrorMsg    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reports      ReportIntegration[]
  dailyMetrics DailyMetric[]

  @@unique([companyId, provider, externalAccount])
  @@index([agencyId, companyId])
  @@index([agencyId, status])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// DAILY_METRIC — Cache de métricas por dia por integração
// Estrutura análoga ao ALL_DATA do Tron dashboard
// ---------------------------------------------------------------------------
model DailyMetric {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  date          DateTime @db.Date
  // "campaign" | "adset" | "organic_ig" | "organic_fb" | "crm" | "creative"
  metricType    String   @db.VarChar(50)
  // campaign_id, adset_id, post_id, "summary", etc.
  entityId      String?  @db.VarChar(255)
  entityName    String?  @db.VarChar(255)
  // Métricas brutas: { leads, spend, impressions, clicks, ctr, cpc, cpm, cpl, ... }
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, date, metricType, entityId])
  @@index([integrationId, date])
  @@index([integrationId, metricType, date])
  @@map("daily_metrics")
}

// ---------------------------------------------------------------------------
// REPORT — Relatório publicado / compartilhado com o cliente
// ---------------------------------------------------------------------------
model Report {
  id             String       @id @default(uuid()) @db.Uuid
  agencyId       String       @db.Uuid
  companyId      String       @db.Uuid
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  status         ReportStatus @default(DRAFT)
  shareToken     String?      @unique @db.VarChar(64) // Token para acesso público sem login
  shareExpiresAt DateTime?
  periodStart    DateTime?    @db.Date
  periodEnd      DateTime?    @db.Date
  layoutJson     Json? // Configuração dos blocos/widgets do relatório (legado)
  // { enabledTabs: ["META_ADS","ORGANIC","CALENDAR","KPI"], defaultTab: "META_ADS" }
  moduleConfig   Json?
  // IA Gemini — sumário narrativo e insights gerados após publicação
  aiSummary      String?      @db.Text @map("ai_summary")
  aiInsights     Json?        @map("ai_insights")
  aiGeneratedAt  DateTime?    @map("ai_generated_at")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  publishedAt    DateTime?

  agency       Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integrations ReportIntegration[]

  @@index([agencyId, companyId])
  @@index([agencyId, status])
  @@index([agencyId, companyId, createdAt(sort: Desc)])
  @@index([shareToken])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// SUPER_ADMIN — Administradores da plataforma Trax (não é user de agência)
// ---------------------------------------------------------------------------
model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// ---------------------------------------------------------------------------
// AGENCY_AUDIT_LOG — Registro de ações realizadas dentro de cada agência
// ---------------------------------------------------------------------------
model AgencyAuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  agencyId     String?         @db.Uuid
  actorType    AuditActorType
  userId       String?         @db.Uuid
  superAdminId String?         @db.Uuid
  action       AuditAction
  entityType   AuditEntityType
  entityId     String?         @db.VarChar(255)
  entityName   String?         @db.VarChar(255)
  description  String          @db.VarChar(512)
  metadata     Json?
  ipAddress    String?         @db.VarChar(45)
  userAgent    String?         @db.VarChar(512)
  createdAt    DateTime        @default(now())

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt(sort: Desc)])
  @@index([agencyId, entityType, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("agency_audit_logs")
}

// ---------------------------------------------------------------------------
// REPORT_INTEGRATION — Integrações utilizadas por um relatório
// ---------------------------------------------------------------------------
model ReportIntegration {
  reportId      String @db.Uuid
  integrationId String @db.Uuid

  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([reportId, integrationId])
  @@map("report_integrations")
}

// ---------------------------------------------------------------------------
// SCHEDULED_POST — Agendamento de posts orgânicos (IG/FB)
// ---------------------------------------------------------------------------
enum ScheduledPostStatus {
  PENDING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ScheduledPostPlatform {
  INSTAGRAM
  FACEBOOK
}

model ScheduledPost {
  id          String               @id @default(uuid()) @db.Uuid
  agencyId    String               @db.Uuid
  companyId   String               @db.Uuid
  platform    ScheduledPostPlatform
  caption     String?              @db.Text
  mediaUrl    String               @db.VarChar(1024)
  scheduledAt DateTime
  status      ScheduledPostStatus  @default(PENDING)
  externalId  String?              @db.VarChar(255)
  errorMsg    String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([agencyId, companyId, status])
  @@index([scheduledAt, status])
  @@map("scheduled_posts")
}

// ---------------------------------------------------------------------------
// COMPANY_META_CONFIG — Configuração por empresa para Meta Ads
// (produtos, estados, distribuição UF, thresholds) — substitui hardcode
// ---------------------------------------------------------------------------
model CompanyMetaConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @db.Uuid
  // [{ key, label, color, monthlyBudgetTarget, namePatterns: string[] }]
  products              Json
  // [{ code, label, aliases: string[] }]
  states                Json
  // { [productKey]: { [stateCode]: pct } } — soma 100% por produto
  stateBudgetByProduct  Json
  // { ctr:{good,warn}, cpc:{warn,bad}, cpm:{warn,bad}, cpl:{warn,bad} }
  thresholds            Json
  // Fator multiplicador para alcance estimado (default 0.72)
  reachFactor           Float    @default(0.72)
  // Cor da seção secundária (Rio Verde / segunda conta)
  secondaryAccountColor String   @default("#06B6D4") @db.VarChar(7)
  // Janela em dias para sparklines (default 14)
  sparklineDays         Int      @default(14)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_meta_configs")
}
