# =============================================================================
# TRAX — Ambiente PRODUÇÃO
# Copie este arquivo para .env no servidor e preencha os valores reais.
# NUNCA commite o arquivo .env.
# Documentação: docs/production.md
# =============================================================================

# --- Aplicação ---
NODE_ENV=production
APP_PORT=3000
APP_URL=https://api.traxsolucoes.com.br

# --- Domínios ---
TRAX_BASE_DOMAIN=traxsolucoes.com.br
TRAX_WEB_PORT=3001
TRAX_API_PORT=3000
WEB_APP_URL=https://traxsolucoes.com.br
API_PUBLIC_URL=https://api.traxsolucoes.com.br
API_URL=http://api:3000
NEXT_PUBLIC_TRAX_BASE_DOMAIN=traxsolucoes.com.br
NEXT_PUBLIC_BASE_DOMAIN=traxsolucoes.com.br
NEXT_PUBLIC_API_URL=https://api.traxsolucoes.com.br

# --- NextAuth (trax-web) ---
AUTH_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_256_BITS

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_USER=trax
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
POSTGRES_DB=trax_prod
POSTGRES_HOST=postgres

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}?schema=public"

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# --- JWT ---
JWT_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_256_BITS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SUBSTITUA_POR_SEGREDO_DIFERENTE_256_BITS
JWT_REFRESH_EXPIRES_IN=7d

TENANT_CACHE_TTL=300

# --- Criptografia ---
ENCRYPTION_KEY=SUBSTITUA_POR_CHAVE_HEX_64_CHARS

# --- CORS ---
CORS_ORIGINS=https://traxsolucoes.com.br,https://admin.traxsolucoes.com.br

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Google Ads ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=https://api.traxsolucoes.com.br/api/v1/integrations/google-ads/callback

# --- URLs produção (referência) ---
# Landing:        https://traxsolucoes.com.br
# Super-admin:    https://admin.traxsolucoes.com.br
# Agências:       https://{slug}.traxsolucoes.com.br
# API:            https://api.traxsolucoes.com.br
