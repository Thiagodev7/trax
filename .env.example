# =============================================================================
# TRAX — Environment Variables Example
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# =============================================================================

# --- Aplicação ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_USER=trax
POSTGRES_PASSWORD=trax_dev_password
POSTGRES_DB=trax_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Redis (Cache de Tenant) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# --- JWT ---
JWT_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_256_BITS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SUBSTITUA_POR_SEGREDO_DIFERENTE_256_BITS
JWT_REFRESH_EXPIRES_IN=7d

# --- Tenant ---
# Domínio base do SaaS (subdomínios: <agency>.trax.app)
TRAX_BASE_DOMAIN=trax.app

# Tempo de TTL do cache de resolução de domínio (segundos)
TENANT_CACHE_TTL=300

# --- Criptografia (Segredos de Integração) ---
# Chave AES-256: deve ter exatamente 32 bytes em hex (64 chars hex)
ENCRYPTION_KEY=SUBSTITUA_POR_CHAVE_HEX_64_CHARS

# --- PgAdmin (apenas dev) ---
PGADMIN_EMAIL=admin@trax.local
PGADMIN_PASSWORD=pgadmin_dev_password
PGADMIN_PORT=5050

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
