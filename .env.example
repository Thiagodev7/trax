# =============================================================================
# TRAX — Ambiente LOCAL (Development)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# Documentação: docs/local-development.md
# =============================================================================

# --- Aplicação ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Domínios (local usa *.localhost) ---
TRAX_BASE_DOMAIN=localhost
TRAX_WEB_PORT=3001
TRAX_API_PORT=3000
WEB_APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:3000
NEXT_PUBLIC_TRAX_BASE_DOMAIN=localhost
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- NextAuth (trax-web) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_256_BITS

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_USER=trax
POSTGRES_PASSWORD=trax_dev_password
POSTGRES_DB=trax_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
DIRECT_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Redis (Cache de Tenant) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# --- JWT ---
JWT_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_256_BITS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SUBSTITUA_POR_SEGREDO_DIFERENTE_256_BITS
JWT_REFRESH_EXPIRES_IN=7d

# Tempo de TTL do cache de resolução de domínio (segundos)
TENANT_CACHE_TTL=300

# --- Criptografia (Segredos de Integração) ---
# Chave AES-256: deve ter exatamente 32 bytes em hex (64 chars hex)
ENCRYPTION_KEY=SUBSTITUA_POR_CHAVE_HEX_64_CHARS

# --- PgAdmin (apenas dev) ---
PGADMIN_EMAIL=admin@trax.local
PGADMIN_PASSWORD=pgadmin_dev_password
PGADMIN_PORT=5050

# --- CORS ---
# Origens explícitas + regex para *.localhost em main.ts
CORS_ORIGINS=http://localhost:3001,http://admin.localhost:3001,http://agenciademo.localhost:3001

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Google Ads (integração OAuth + sync) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google-ads/callback

# --- URLs locais (referência) ---
# Landing:        http://localhost:3001
# Super-admin:    http://admin.localhost:3001
# Agência demo:   http://agenciademo.localhost:3001
# API / Swagger:  http://localhost:3000/api/docs
# Com Caddy (:80): npm run dev:proxy → http://admin.localhost (sem porta)
